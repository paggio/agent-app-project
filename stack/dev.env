# Local values for the joined stack and the suites that run against it.
#
# The MIDDLE of three layers, loaded by scripts/dev-env.sh. docs/adr/0006 is the decision:
#
#   1. the real environment          always wins. `CHAT_MODEL=echo make up` overrides, and
#                                    a deployed environment that sets these for real is
#                                    untouched by this file.
#   2. this file                     the control repo's committed view of the stack.
#   3. chatbot-backend/.env          the backend developer's gitignored file, for the
#                                    non-secret names dev-env.sh allowlists.
#
# So a variable this file does NOT declare falls through to the submodule, and its silence
# is a deliberate deferral. CHAT_MODEL is the working example: undeclared here on purpose,
# so a developer with Bedrock credentials gets Bedrock and CI gets echo, from one commit.
#
# THE COROLLARY, AND IT IS A TRAP: declaring a name here that chatbot-backend/.env also
# sets does not "override for the stack" — dev-env.sh exports THIS value into the process
# environment, which is layer 1, so the submodule's value can never be reached again.
# scripts/check-docs.py fails on that overlap rather than leaving it to be discovered.
#
# Safe to commit because nothing here guards anything reachable. A real value never lands
# in a committed file — but note that `docker compose config` INLINES the credentials from
# chatbot-backend/.env into its output. Use `make config`, which redacts. See CLAUDE.md.

# Gates POST /v1/auth/register. The backend fails CLOSED when unset: registration is
# refused rather than opened, so a deployment that forgets it is safe rather than wide open.
SIGNUP_CODE=dev-signup-code

# Must stay false here: the origin is http, and Python's http.cookiejar will not return a
# Secure cookie over http with no localhost exemption — so `true` fails every
# session-carrying step against a CORRECT implementation. On wherever the origin is https.
SESSION_COOKIE_SECURE=false

# The password the auth suite registers and signs in with. Must satisfy the policy the
# contract states: 12-128 characters, not on the common-password list.
SMOKE_PASSWORD=smoke-orbit-lantern-42

# The backend's own port, bypassing the proxy. Lets a suite tell "the proxy wiring is
# broken" apart from "the backend is broken" — which is the difference between a frontend
# slice and a backend slice.
BACKEND_DIRECT_BASE=http://localhost:8000

# The document size limit the joined stack runs with. 10 MB, the same as the backend's own
# default — the joined stack no longer overrides it. It USED to be 2000 so that an oversize
# upload could be refused by a fixture short enough to read; at 10 MB no readable fixture
# trips it, so that smoke step is gone and the criterion moved into chatbot-backend's tests,
# where 10 MB is a generated buffer. Kept declared rather than deleted: it is what the app
# reports to a person when it refuses, and a deployment should be able to move it.
DOCUMENT_MAX_BYTES=10485760

# ─────────────────────────────────────────────────────────── observability (0005)

# Phoenix's own origin. NOT reachable through the proxy, and deliberately so: Phoenix is a
# developer-facing service, not part of the API, and a trace read that went through /api
# would be asserting the proxy rather than the tracing. Only changes/0005's suite uses it.
PHOENIX_BASE=http://localhost:6006

# The Phoenix project the backend registers its spans under. ONE name in one file: the
# suite interpolates it into project-scoped queries and stack/compose.yml passes the same
# value to the backend, so a backend exporting under some other name gets a 404 from
# Phoenix rather than a quietly empty result that reads like "no traces yet".
PHOENIX_PROJECT_NAME=chatbot-backend

# The standing local account, so signing in by hand does not mean inventing one. SEEDED BY
# THE BACKEND at startup, and only when BOTH names are set — unset means no account is
# created, which is how every environment that is not a developer's machine behaves.
#
# Committed, like SIGNUP_CODE above, and safe for the same reason: it guards nothing
# reachable. The backend REFUSES to seed an address outside a `.test` TLD (RFC 2606
# reserved), so a stray copy of these variables in a real deployment creates nothing rather
# than creating a known-password account on it.
#
# The password satisfies the stated policy — 12-128 characters, not on the common-password
# list — because seeding goes through the same validation a registration does. A weaker one
# here would fail at startup rather than be silently accepted.
DEV_ACCOUNT_EMAIL=dev@auth.test
DEV_ACCOUNT_PASSWORD=dev-orbit-lantern-42

# ─────────────────────────────────────────────────────────────────── eval (0006)

# The eval runner is a fourth repo and a one-shot container: it signs in as its own
# account, seeds that account's knowledge base from its own fixture corpus, and files a
# Phoenix experiment. Everything below is non-secret configuration, declared here because
# stack/compose.yml passes it to the container AND changes/0006's suite interpolates it —
# one name in one file, which is what stops the suite and the container disagreeing about
# what was measured.

# The Phoenix project the eval's OWN spans go to. NOT the backend's: a service's project is
# its own configuration, so one eval example draws one trace whose halves live in two
# projects, joined by the trace id the eval records. changes/0006/BRIEF.md says why.
EVAL_PHOENIX_PROJECT_NAME=chatbot-eval

# The Phoenix dataset the question set is upserted into. Phoenix versions it, so a changed
# question set adds a version rather than a second dataset.
EVAL_DATASET_NAME=chatbot-eval

# The eval's standing account. This IS its dedicated collection — the knowledge base is
# scoped by account, so the eval structurally cannot see or touch anybody else's documents.
# Registered by the eval itself on a cold stack (docs/adr/0011: `down` forgets everything)
# and signed into on a warm one, so the same two values work either way.
#
# Committed, and safe for the same reason SIGNUP_CODE and DEV_ACCOUNT_* above are: it guards
# nothing reachable, and `.test` is reserved by RFC 2606 so it can never collide with a real
# address. The password satisfies the stated policy — 12-128 characters, not on the common
# list — because registration applies the same validation to it as to anyone.
EVAL_ACCOUNT_EMAIL=eval@auth.test
EVAL_ACCOUNT_PASSWORD=eval-orbit-lantern-42

# The marker every document the eval uploads carries in its filename, and the only prefix it
# will ever DELETE. This is the safety property, not a naming convention: an
# EVAL_ACCOUNT_EMAIL pointed at a real account by mistake loses nothing. The suite asserts
# that every document in the eval account carries it.
EVAL_DOCUMENT_PREFIX=eval__

# Which judge scores groundedness and answer correctness. `heuristic` calls no model and
# needs no credentials; `bedrock` is the real one. heuristic is the default here for exactly
# the reason CHAT_MODEL is undeclared in this file and RETRIEVAL_ROUTER defaults to
# heuristic in the backend: the loop and CI must be able to exercise the whole pipeline —
# the experiment, all four score columns, the thresholds, the exit code — on a machine with
# no AWS access. A heuristic judge produces a real number and a poor one.
EVAL_JUDGE=heuristic
# Recorded in the experiment metadata even when unused, so an experiment always says what
# judged it. The prompt version is bumped by hand when the judge prompt changes, because
# two runs judged by different prompts are not comparable and nothing else would say so.
EVAL_JUDGE_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
EVAL_JUDGE_PROMPT_VERSION=1

# The gate: an aggregate below its threshold is exit 1. A mean over the examples the
# evaluator APPLIES to — an evaluator that does not apply to an example records no score
# for it rather than a zero, or the aggregate would measure the question set instead of the
# backend.
#
# THE TWO CODE-BASED ONES GATE FOR REAL. Routing and retrieval work with no credentials:
# the router is lexical, the embedder is a local ONNX model, and the ingest summariser is
# deterministic when no chat model is configured — so these two numbers are meaningful in
# the loop and a regression in either fails a run.
EVAL_THRESHOLD_ROUTING_ACCURACY=0.8
EVAL_THRESHOLD_RETRIEVAL_RECALL=0.6
# THE TWO JUDGE-BASED ONES ARE 0 ON PURPOSE, and this is the honest half of the change.
# With CHAT_MODEL=echo the reply is the question echoed back, so groundedness and
# correctness are near zero against ANY judge — gating on them here would fail every run
# for a reason that is not a defect. They become real with CHAT_MODEL=bedrock and
# EVAL_JUDGE=bedrock, which is a credentialled run somebody starts on purpose. Declared at
# 0 rather than omitted so that raising one is a one-line, reviewable change.
EVAL_THRESHOLD_GROUNDEDNESS=0.0
EVAL_THRESHOLD_ANSWER_CORRECTNESS=0.0

# What the backend reports as its `image_tag` from GET /v1/version, and what the eval
# records in the experiment metadata. `dev` locally; a deploy sets the real tag. Declared
# rather than defaulted inside the backend, because a build identity invented by the
# application is not a build identity.
BACKEND_IMAGE_TAG=dev
