# Local values for the joined stack and the suites that run against it.
#
# The MIDDLE of three layers, loaded by scripts/dev-env.sh. docs/adr/0006 is the decision:
#
#   1. the real environment          always wins. `CHAT_MODEL=echo make up` overrides, and
#                                    a deployed environment that sets these for real is
#                                    untouched by this file.
#   2. this file                     the control repo's committed view of the stack.
#   3. chatbot-backend/.env          the backend developer's gitignored file, for the
#                                    non-secret names dev-env.sh allowlists.
#
# So a variable this file does NOT declare falls through to the submodule, and its silence
# is a deliberate deferral. CHAT_MODEL is the working example: undeclared here on purpose,
# so a developer with Bedrock credentials gets Bedrock and CI gets echo, from one commit.
#
# THE COROLLARY, AND IT IS A TRAP: declaring a name here that chatbot-backend/.env also
# sets does not "override for the stack" — dev-env.sh exports THIS value into the process
# environment, which is layer 1, so the submodule's value can never be reached again.
# scripts/check-docs.py fails on that overlap rather than leaving it to be discovered.
#
# Safe to commit because nothing here guards anything reachable. A real value never lands
# in a committed file — but note that `docker compose config` INLINES the credentials from
# chatbot-backend/.env into its output. Use `make config`, which redacts. See CLAUDE.md.

# Gates POST /v1/auth/register. The backend fails CLOSED when unset: registration is
# refused rather than opened, so a deployment that forgets it is safe rather than wide open.
SIGNUP_CODE=dev-signup-code

# Must stay false here: the origin is http, and Python's http.cookiejar will not return a
# Secure cookie over http with no localhost exemption — so `true` fails every
# session-carrying step against a CORRECT implementation. On wherever the origin is https.
SESSION_COOKIE_SECURE=false

# The password the auth suite registers and signs in with. Must satisfy the policy the
# contract states: 12-128 characters, not on the common-password list.
SMOKE_PASSWORD=smoke-orbit-lantern-42

# The backend's own port, bypassing the proxy. Lets a suite tell "the proxy wiring is
# broken" apart from "the backend is broken" — which is the difference between a frontend
# slice and a backend slice.
BACKEND_DIRECT_BASE=http://localhost:8000

# The document size limit the joined stack runs with. 10 MB, the same as the backend's own
# default — the joined stack no longer overrides it. It USED to be 2000 so that an oversize
# upload could be refused by a fixture short enough to read; at 10 MB no readable fixture
# trips it, so that smoke step is gone and the criterion moved into chatbot-backend's tests,
# where 10 MB is a generated buffer. Kept declared rather than deleted: it is what the app
# reports to a person when it refuses, and a deployment should be able to move it.
DOCUMENT_MAX_BYTES=10485760

# ─────────────────────────────────────────────────────────── observability (0005)

# Phoenix's own origin. NOT reachable through the proxy, and deliberately so: Phoenix is a
# developer-facing service, not part of the API, and a trace read that went through /api
# would be asserting the proxy rather than the tracing. Only changes/0005's suite uses it.
PHOENIX_BASE=http://localhost:6006

# The Phoenix project the backend registers its spans under. ONE name in one file: the
# suite interpolates it into project-scoped queries and stack/compose.yml passes the same
# value to the backend, so a backend exporting under some other name gets a 404 from
# Phoenix rather than a quietly empty result that reads like "no traces yet".
PHOENIX_PROJECT_NAME=chatbot-backend
