# Non-secret configuration for the joined stack, grouped by the service it configures.
# It is also the ONLY declared source of the ${VARS} the smoke suites interpolate.
#
# SECRETS DO NOT LIVE HERE — this file is committed. Real credentials go in
# stack/secrets.env, which is gitignored; copy stack/secrets.env.example to start.
# docs/adr/0016.
#
# Precedence, highest first (docs/adr/0006):
#   1. the real environment      `CHAT_MODEL=echo make up` always wins
#   2. this file                 the joined stack's committed view
#   3. <submodule>/.env          that repo's own file, for running it standalone
#
# Two rules the parser enforces on you, both checked by scripts/check-docs.py:
#   * ONE line per name. A name declared twice resolves to the FIRST — the second is dead.
#   * NO trailing comments. Everything after the first `=` is the value, verbatim; there is
#     no quote stripping and no comment stripping. Comments go on their own line.
#
# The committed passwords below are `.test` identities that guard nothing reachable, and
# the suites have to interpolate them — see docs/adr/0005. They are not the secrets this
# file is warning you about.

# ─────────────────────────────────────────────────────────────────────── backend

# Gates POST /v1/auth/register. The backend fails CLOSED when empty, so a deployment that
# forgets it refuses registration rather than opening it.
SIGNUP_CODE=dev-signup-code

# Must stay false on an http origin: http.cookiejar will not return a Secure cookie over
# http, so `true` fails every session-carrying step against a CORRECT implementation.
SESSION_COOKIE_SECURE=false

# 10 MB, the backend's own default. Kept declared because a deployment should be able to
# move it and because it is what the app reports when it refuses an upload.
DOCUMENT_MAX_BYTES=10485760

# Reported by GET /v1/version and recorded in every Phoenix experiment. BUMP IT when a
# change touches chatbot-backend — check-docs.py [image-tags] refuses otherwise, and an
# unbumped tag makes two builds indistinguishable. docs/adr/0015.
BACKEND_IMAGE_TAG=local-0.2.0

# The standing local account, seeded by the backend at startup and only when both names are
# set. It refuses any address outside a `.test` TLD, so a stray copy in a real deployment
# creates nothing.
DEV_ACCOUNT_EMAIL=dev@auth.test
DEV_ACCOUNT_PASSWORD=dev-orbit-lantern-42

# ─────────────────────────────────────────────────────────── call queue (ElasticMQ)

# The local SQS-compatible queue, on its host port. Smoke publishes CallCompleted events to it
# directly (unsigned, which only ElasticMQ accepts), so these steps are `local`.
CALL_QUEUE_BASE=http://localhost:9324

# ─────────────────────────────────────────────────────────────── phoenix (traces)

# Phoenix's own origin, NOT proxied: it is a developer-facing service, not part of the API.
PHOENIX_BASE=http://localhost:6006

# The project the BACKEND files its spans under. One name in one file — the suite
# interpolates it and compose passes the same value, so a mismatch is a 404 rather than a
# quietly empty result.
PHOENIX_PROJECT_NAME=chatbot-backend

# The project the call WORKER files its ingest spans under — apart from the chat traces, so
# one ingest a minute does not bury the conversations. The backend's default is the same.
PHOENIX_CALLS_PROJECT_NAME=chatbot-backend-calls

# ────────────────────────────────────────────────────────────────────────── eval

# The eval's OWN Phoenix project. A service's project is its own configuration, so one eval
# example draws one trace whose halves live in two projects, joined by the trace id.
EVAL_PHOENIX_PROJECT_NAME=chatbot-eval

# The dataset the question set is upserted into, BY NAME, so two runs leave one dataset.
EVAL_DATASET_NAME=chatbot-eval

# Bump when a change touches chatbot-eval. Recorded in the experiment metadata beside
# fixture_hash: the evaluator code is as much a factor in a score as the corpus is.
EVAL_IMAGE_TAG=local-0.2.0

# The eval's own account, which IS its dedicated collection — the knowledge base is scoped
# by account, so it structurally cannot see anybody else's documents. It registers this
# itself on a cold stack and signs in on a warm one.
EVAL_ACCOUNT_EMAIL=eval@auth.test
EVAL_ACCOUNT_PASSWORD=eval-orbit-lantern-42

# The markers the eval puts on what it creates, and the ONLY prefixes it will ever DELETE.
# This is the safety property, not a convention: an EVAL_ACCOUNT_EMAIL pointed at a real
# account loses neither a document nor a conversation.
EVAL_DOCUMENT_PREFIX=eval__
EVAL_THREAD_PREFIX=eval__

# Which judge scores groundedness and answer correctness. `heuristic` calls no model and
# needs no credentials, which is why it is the default — the loop and CI must exercise the
# whole pipeline with no AWS access. `bedrock` is the real judge and needs
# stack/secrets.env; run it with `make eval JUDGE=bedrock`.
EVAL_JUDGE=heuristic

# Recorded in the metadata even when unused, so an experiment always says what judged it.
# Bump the prompt version by hand when a judge prompt changes — two runs judged by
# different prompts are not comparable and nothing else would say so.
EVAL_JUDGE_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
EVAL_JUDGE_PROMPT_VERSION=1

# The gate: an aggregate below its threshold is exit 1.
# These two are REAL with no credentials — the router is lexical, the embedder is a local
# ONNX model, the ingest summariser is deterministic — so a regression in either fails a run.
EVAL_THRESHOLD_ROUTING_ACCURACY=0.8
EVAL_THRESHOLD_RETRIEVAL_RECALL=0.6
# These two are 0 ON PURPOSE. Under CHAT_MODEL=echo the reply is the question echoed back,
# so both are near zero against any judge and gating would fail every run for a reason that
# is not a defect. They become meaningful with CHAT_MODEL=bedrock and EVAL_JUDGE=bedrock.
EVAL_THRESHOLD_GROUNDEDNESS=0.0
EVAL_THRESHOLD_ANSWER_CORRECTNESS=0.0

# ──────────────────────────────────────────────── metrics (analytics-dbt, metrics-gateway)

# The gateway's own origin on the host. It has NO origin on dev — only the backend may reach
# it there — so every step against it is `local`.
METRICS_GATEWAY_ORIGIN=http://localhost:8091

# The Phoenix project the gateway files one span per tool call under.
METRICS_PHOENIX_PROJECT_NAME=metrics-gateway

# The release sha the local release job publishes by default. On dev it is the analytics-dbt
# commit the image was built from; locally there is no such commit inside the image, so it
# is declared here rather than invented.
METRICS_BASE_RELEASE_SHA=c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0

# The two fixture releases change 0009's jobs publish after it — A indexed and served, B
# published and never indexed. The same literals are in that change's change.yaml `env:`.
METRICS_FIXTURE_SHA_A=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1
METRICS_FIXTURE_SHA_B=b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2

# How often the gateway polls current.json. Short locally so smoke is not waiting on it.
METRICS_RELEASE_POLL_S=3

# ───────────────────────────────────────────────────────────── the suites themselves

# The password the suites register and sign in with. Must satisfy the stated policy:
# 12-128 characters, not on the common-password list.
SMOKE_PASSWORD=smoke-orbit-lantern-42

# The backend's own port, bypassing the proxy, so a suite can tell "the proxy wiring is
# broken" apart from "the backend is broken" — which is the difference between a frontend
# slice and a backend slice.
BACKEND_DIRECT_BASE=http://localhost:8000
