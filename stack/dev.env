# Local values for the joined stack and for the suites that run against it.
#
# ONE source, loaded by scripts/dev-env.sh, which both stack.sh (so compose can
# interpolate them) and verify.sh (so smoke.yaml's ${VARS} resolve) source before doing
# anything. That is the whole point: a change declares the variables its smoke suite needs
# and the ship process supplies them. Nobody exports anything by hand.
#
# THE REAL ENVIRONMENT ALWAYS WINS. The loader only fills in what is unset, so
# `SIGNUP_CODE=other ./scripts/iterate.sh ...` overrides, and a deployed environment that
# sets these for real is untouched by this file.
#
# Local-dev only, and safe to commit for the same reason chatbot-backend's compose file
# commits chatbot:chatbot — nothing here guards anything reachable. A real value never
# lands in a committed file.

# --- the joined stack -------------------------------------------------------------------

# Gates POST /v1/auth/register. The backend fails CLOSED when this is unset or empty:
# registration is refused rather than opened, so a deployment that forgets the variable
# is safe rather than wide open. Set here so the local stack is usable.
SIGNUP_CODE=dev-signup-code

# Off for the local stack, and it must stay off: the origin is http://localhost:8080, and
# Python's http.cookiejar will not return a Secure cookie over HTTP with no localhost
# exemption — so turning this on makes every session-carrying smoke step fail against a
# correct implementation. On wherever the origin is HTTPS. See contracts/README.md.
SESSION_COOKIE_SECURE=false

# --- the smoke suites ------------------------------------------------------------------

# The password changes/0001-auth/smoke.yaml registers and signs in with. Must satisfy the
# policy the contract states: 12-128 characters and not on the common-password list.
SMOKE_PASSWORD=smoke-orbit-lantern-42

# The backend's own port, bypassing the proxy. smoke/baseline.yaml's backend-direct-health
# step interpolates it to tell "the proxy wiring is broken" apart from "the backend is
# broken" — which is the difference between a frontend slice and a backend slice.
#
# It lives here because CLAUDE.md says every variable a suite interpolates is declared in
# this file, and this one was the exception that proved the rule was ignorable: it was
# hand-exported by the Makefile and defaulted again in verify.sh, in the BASELINE suite,
# which every change runs.
BACKEND_DIRECT_BASE=http://localhost:8000
