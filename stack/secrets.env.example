# Real credentials for the joined stack. ONE file, shared by every service that needs them.
#
#   cp stack/secrets.env.example stack/secrets.env    then fill it in
#
# stack/secrets.env is gitignored and NEVER committed. This template is committed and must
# never hold a real value.
#
# WHO READS IT: compose's `env_file:`, and therefore the Docker daemon. `scripts/dev-env.sh`
# reads the mode lines only, through an allowlist — a credential must not enter a
# control-repo process, because this repo writes verify.json, smoke.json, container logs
# and repair prompts. docs/adr/0006, 0016 and 0017; check-docs.py [provider-credentials].
# The exceptions write no artifact: `make login` writes the credential lines,
# `make push-gh-creds` copies them to GitHub, and scripts/with-aws.sh hands them to one
# command. docs/adr/0018.
#
# WHO GETS IT: `backend` and `eval`, declared in stack/compose.yml. A submodule's own
# `.env` still works for running that repo standalone, and this file WINS over it in the
# joined stack — measured, not assumed.
#
# `make up`, `make eval`, `make iterate` and the loop all pick this up with no extra step.
# `make creds` says whether it is present and what resolved.

# ─────────────────────────────────────────────────────────────────────────── AWS
# Bedrock, for CHAT_MODEL=bedrock (backend) and EVAL_JUDGE=bedrock (eval). No code in
# either repo reads an AWS_* variable — boto3 does, from its default credential chain.
#
# Leave the whole block empty to run credential-free: the backend serves CHAT_MODEL=echo
# and the eval runs its heuristic judge. That is the default and CI does exactly that.

# THE REGION IS NOT OPTIONAL and its absence is why this file exists. boto3 resolves a
# region from the environment or refuses, and the failure reads as a credentials error:
#   Could not load credentials to authenticate with AWS client ... You must specify a region
# Both names are set because boto3 checks AWS_REGION first and AWS_DEFAULT_REGION second,
# and other tooling disagrees about which it wants.
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# `make login` writes these four from an SSO session; nothing else should.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials from `aws sts` or SSO. Delete the line for a long-lived key
# — an EMPTY value is still a value, and boto3 will send it and be refused.
AWS_SESSION_TOKEN=
# When the session dies. with-aws.sh and push-gh-creds.sh refuse a session about to.
AWS_CREDENTIAL_EXPIRATION=

# ───────────────────────────────────────────────── the mode these credentials are for
# CREDENTIALS ALONE SWITCH NOTHING. The backend never sniffs for them: which model it
# builds is an explicit selector, by design — see chatbot-backend's docs/adr/0001 and 0004.
# Leave both unset and a fully credentialled stack still runs `echo` and the heuristic
# judge, which is what CI and the verify loop do and must keep doing.
#
# These two are NOT secrets, and they are the only names any script in this repo reads out
# of this file — through an allowlist, so a credential can never follow them. docs/adr/0017.
#
# THE LOUD PART: `make creds` prints what these resolve to and says so when credentials are
# present but the model is still echo, and verify.json records both on every run. An
# expired token has been charged to a product repo four times because a run reached for a
# provider and nothing said it had.

# echo (free, deterministic, no network) or bedrock (a real model, real money).
CHAT_MODEL=bedrock

# heuristic (no credentials, proves the mechanism) or bedrock (the real judge).
# `make eval JUDGE=bedrock` overrides this for one run.
EVAL_JUDGE=heuristic
