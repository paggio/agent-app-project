# Real credentials for the joined stack. ONE file, shared by every service that needs them.
#
#   cp stack/secrets.env.example stack/secrets.env    then fill it in
#
# stack/secrets.env is gitignored and NEVER committed. This template is committed and must
# never hold a real value.
#
# WHO READS IT: compose's `env_file:`, and therefore the Docker daemon. Nothing in this
# repo's own scripts reads it, and `scripts/dev-env.sh` is forbidden from naming it — a
# credential must not enter a control-repo process, because this repo writes verify.json,
# smoke.json, container logs and repair prompts. docs/adr/0006 and docs/adr/0016;
# check-docs.py [provider-credentials] enforces it.
#
# WHO GETS IT: `backend` and `eval`, declared in stack/compose.yml. A submodule's own
# `.env` still works for running that repo standalone, and this file WINS over it in the
# joined stack — measured, not assumed.
#
# `make up`, `make eval`, `make iterate` and the loop all pick this up with no extra step.
# `make creds` says whether it is present and what resolved.

# ─────────────────────────────────────────────────────────────────────────── AWS
# Bedrock, for CHAT_MODEL=bedrock (backend) and EVAL_JUDGE=bedrock (eval). No code in
# either repo reads an AWS_* variable — boto3 does, from its default credential chain.
#
# Leave the whole block empty to run credential-free: the backend serves CHAT_MODEL=echo
# and the eval runs its heuristic judge. That is the default and CI does exactly that.

# THE REGION IS NOT OPTIONAL and its absence is why this file exists. boto3 resolves a
# region from the environment or refuses, and the failure reads as a credentials error:
#   Could not load credentials to authenticate with AWS client ... You must specify a region
# Both names are set because boto3 checks AWS_REGION first and AWS_DEFAULT_REGION second,
# and other tooling disagrees about which it wants.
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials from `aws sts` or SSO. Delete the line for a long-lived key
# — an EMPTY value is still a value, and boto3 will send it and be refused.
AWS_SESSION_TOKEN=
