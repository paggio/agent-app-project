# OS
.DS_Store

# Secrets — never commit these
.env
.env.*
!.env.example

# Local agent state (settings.json IS committed; local overrides are not)
.claude/settings.local.json

# Personal
instructions.md
TODO.md

# Deploy/smoke evidence from ./scripts/iterate.sh — logs, container output, agent
# transcripts. Regenerated on every run and often large; report.md is the durable part
# and is meant to be read in place, not committed.
changes/*/runs/

# The joined stack's shared provider credentials. Read only by compose's `env_file:`, and
# never by a script here — docs/adr/0016. The .example beside it IS committed.
stack/secrets.env

# A crashed run leaves the environment lock behind; it is never committable.
.locks/

# A stray import leaves one of these behind; a committed .pyc is one careless add away.
__pycache__/
*.pyc
