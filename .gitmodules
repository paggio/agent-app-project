[submodule "backend"]
	path = chatbot-backend
	url = https://github.com/Paggio/chatbot-backend.git
	images = backend
[submodule "frontend"]
	path = frontend
	url = https://github.com/Paggio/frontend.git
	images = frontend proxy:Dockerfile.proxy
[submodule "infra"]
	path = infra
	url = https://github.com/Paggio/infra.git
[submodule "chatbot-eval"]
	path = chatbot-eval
	url = https://github.com/Paggio/chatbot-eval.git
[submodule "analytics-dbt"]
	path = analytics-dbt
	url = https://github.com/Paggio/analytics-dbt.git
	images = dbt
